# Copy to .env and fill in real values. .env is gitignored, never commit it.

OPENAI_API_KEY=
YOUTUBE_API_KEY=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Shared secret the core service sends on every request to this service.
# Must match the same value the core service is configured with.
INTERNAL_SERVICE_API_KEY=

OPENAI_MODEL=gpt-5.1

# Local/cheap LLM spike (story 20), see ai/spikes/. llama.cpp needs no key,
# it runs locally.
ZHIPU_API_KEY=
GROQ_API_KEY=
DEEPINFRA_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
